//
// Fused Adam step for one tensor:
//   M=b1*M+(1-b1)*G ; V=b2*V+(1-b2)*G^2 ; P -= lr*(M/bc1)/(sqrt(V/bc2)+eps)
// bc1=1-b1^t, bc2=1-b2^t を host で計算して渡す。1D. sm_75.
//
.version 7.0
.target sm_75
.address_size 64
.visible .entry adam(
    .param .u64 P, .param .u64 G, .param .u64 M, .param .u64 Vv, .param .u32 n,
    .param .f32 lr, .param .f32 b1, .param .f32 b2,
    .param .f32 bc1, .param .f32 bc2, .param .f32 eps)
{
    .reg .pred %p; .reg .b32 %r<8>; .reg .f32 %flr,%fb1,%fb2,%fc1,%fc2,%fe,%fp,%fg,%fm,%fv,%ft,%fg2,%fmh,%fvh,%fupd; .reg .b64 %rd<12>;
    ld.param.u64 %rd1,[P]; ld.param.u64 %rd2,[G]; ld.param.u64 %rd3,[M]; ld.param.u64 %rd4,[Vv];
    ld.param.u32 %r1,[n];
    ld.param.f32 %flr,[lr]; ld.param.f32 %fb1,[b1]; ld.param.f32 %fb2,[b2];
    ld.param.f32 %fc1,[bc1]; ld.param.f32 %fc2,[bc2]; ld.param.f32 %fe,[eps];
    mov.u32 %r2,%ctaid.x; mov.u32 %r3,%ntid.x; mov.u32 %r4,%tid.x; mad.lo.s32 %r5,%r2,%r3,%r4;
    setp.ge.s32 %p,%r5,%r1; @%p bra DONE;
    cvta.to.global.u64 %rd1,%rd1; cvta.to.global.u64 %rd2,%rd2; cvta.to.global.u64 %rd3,%rd3; cvta.to.global.u64 %rd4,%rd4;
    mul.wide.s32 %rd5,%r5,4;
    add.s64 %rd6,%rd1,%rd5; add.s64 %rd7,%rd2,%rd5; add.s64 %rd8,%rd3,%rd5; add.s64 %rd9,%rd4,%rd5;
    ld.global.f32 %fp,[%rd6]; ld.global.f32 %fg,[%rd7]; ld.global.f32 %fm,[%rd8]; ld.global.f32 %fv,[%rd9];
    // m = b1*m + (1-b1)*g
    mul.f32 %fm,%fm,%fb1; mov.f32 %ft,0f3F800000; sub.f32 %ft,%ft,%fb1; fma.rn.f32 %fm,%ft,%fg,%fm;
    // v = b2*v + (1-b2)*g^2
    mul.f32 %fv,%fv,%fb2; mov.f32 %ft,0f3F800000; sub.f32 %ft,%ft,%fb2; mul.f32 %fg2,%fg,%fg; fma.rn.f32 %fv,%ft,%fg2,%fv;
    st.global.f32 [%rd8],%fm; st.global.f32 [%rd9],%fv;
    // mhat, vhat
    div.rn.f32 %fmh,%fm,%fc1; div.rn.f32 %fvh,%fv,%fc2;
    sqrt.rn.f32 %fvh,%fvh; add.f32 %fvh,%fvh,%fe;
    div.rn.f32 %fupd,%fmh,%fvh; mul.f32 %fupd,%fupd,%flr;
    sub.f32 %fp,%fp,%fupd; st.global.f32 [%rd6],%fp;
DONE: ret;
}
