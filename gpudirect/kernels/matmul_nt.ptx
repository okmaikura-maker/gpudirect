//
// C[M,N] = A[M,K] @ B[N,K]^T   (C[i,j] = sum_k A[i,k]*B[j,k])
// B は [N,K] row-major のまま転置積を取る。注意の Q@K^T や weight-tying の
// logits = x @ Emb^T に使う。2D grid。sm_75。
//
.version 7.0
.target sm_75
.address_size 64
.visible .entry matmul_nt(
    .param .u64 A, .param .u64 B, .param .u64 C,
    .param .u32 M, .param .u32 N, .param .u32 K)
{
    .reg .pred %p,%pk; .reg .b32 %r<20>; .reg .f32 %f<4>; .reg .b64 %rd<14>;
    ld.param.u64 %rd1,[A]; ld.param.u64 %rd2,[B]; ld.param.u64 %rd3,[C];
    ld.param.u32 %r1,[M]; ld.param.u32 %r2,[N]; ld.param.u32 %r3,[K];
    mov.u32 %r4,%ctaid.x; mov.u32 %r5,%ntid.x; mov.u32 %r6,%tid.x;
    mad.lo.s32 %r7,%r4,%r5,%r6;                 // col j
    mov.u32 %r8,%ctaid.y; mov.u32 %r9,%ntid.y; mov.u32 %r10,%tid.y;
    mad.lo.s32 %r11,%r8,%r9,%r10;               // row i
    setp.ge.s32 %p,%r11,%r1; @%p bra DONE;
    setp.ge.s32 %p,%r7,%r2;  @%p bra DONE;
    cvta.to.global.u64 %rd4,%rd1; cvta.to.global.u64 %rd5,%rd2; cvta.to.global.u64 %rd6,%rd3;
    mov.f32 %f1,0f00000000; mov.u32 %r12,0;
    mul.lo.s32 %r13,%r11,%r3;                   // i*K
    mul.lo.s32 %r14,%r7,%r3;                    // j*K
LOOP:
    setp.ge.s32 %pk,%r12,%r3; @%pk bra ENDL;
    add.s32 %r15,%r13,%r12; mul.wide.s32 %rd7,%r15,4; add.s64 %rd8,%rd4,%rd7; ld.global.f32 %f2,[%rd8];
    add.s32 %r16,%r14,%r12; mul.wide.s32 %rd9,%r16,4; add.s64 %rd10,%rd5,%rd9; ld.global.f32 %f3,[%rd10];
    fma.rn.f32 %f1,%f2,%f3,%f1; add.s32 %r12,%r12,1; bra LOOP;
ENDL:
    mul.lo.s32 %r17,%r11,%r2; add.s32 %r18,%r17,%r7; mul.wide.s32 %rd11,%r18,4;
    add.s64 %rd12,%rd6,%rd11; st.global.f32 [%rd12],%f1;
DONE: ret;
}
