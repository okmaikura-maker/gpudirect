//
// db[N] = column-sum of dY[R,N]:  db[j] = sum_r dY[r*N+j]. 1 thread/column. sm_75.
//
.version 7.0
.target sm_75
.address_size 64
.visible .entry bias_grad(.param .u64 dY, .param .u64 db, .param .u32 R, .param .u32 N)
{
    .reg .pred %p,%pk; .reg .b32 %r<10>; .reg .f32 %f<3>; .reg .b64 %rd<8>;
    ld.param.u64 %rd1,[dY]; ld.param.u64 %rd2,[db]; ld.param.u32 %r1,[R]; ld.param.u32 %r2,[N];
    mov.u32 %r3,%ctaid.x; mov.u32 %r4,%ntid.x; mov.u32 %r5,%tid.x; mad.lo.s32 %r6,%r3,%r4,%r5; // j
    setp.ge.s32 %p,%r6,%r2; @%p bra DONE;
    cvta.to.global.u64 %rd3,%rd1; cvta.to.global.u64 %rd4,%rd2;
    mov.f32 %f1,0f00000000; mov.u32 %r7,0;
LOOP:
    setp.ge.s32 %pk,%r7,%r1; @%pk bra ENDL;
    mul.lo.s32 %r8,%r7,%r2; add.s32 %r8,%r8,%r6; mul.wide.s32 %rd5,%r8,4; add.s64 %rd6,%rd3,%rd5; ld.global.f32 %f2,[%rd6];
    add.f32 %f1,%f1,%f2; add.s32 %r7,%r7,1; bra LOOP;
ENDL:
    mul.wide.s32 %rd5,%r6,4; add.s64 %rd7,%rd4,%rd5; st.global.f32 [%rd7],%f1;
DONE: ret;
}
