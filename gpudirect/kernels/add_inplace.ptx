//
// 要素ごとの加算 (残差接続): A[n] += B[n]。1D grid。sm_75。
//
.version 7.0
.target sm_75
.address_size 64
.visible .entry add_inplace(.param .u64 A, .param .u64 B, .param .u32 n)
{
    .reg .pred %p; .reg .b32 %r<8>; .reg .f32 %f<4>; .reg .b64 %rd<8>;
    ld.param.u64 %rd1,[A]; ld.param.u64 %rd2,[B]; ld.param.u32 %r1,[n];
    mov.u32 %r2,%ctaid.x; mov.u32 %r3,%ntid.x; mov.u32 %r4,%tid.x;
    mad.lo.s32 %r5,%r2,%r3,%r4;
    setp.ge.s32 %p,%r5,%r1; @%p bra DONE;
    cvta.to.global.u64 %rd3,%rd1; cvta.to.global.u64 %rd4,%rd2;
    mul.wide.s32 %rd5,%r5,4; add.s64 %rd6,%rd3,%rd5; add.s64 %rd7,%rd4,%rd5;
    ld.global.f32 %f1,[%rd6]; ld.global.f32 %f2,[%rd7]; add.f32 %f1,%f1,%f2;
    st.global.f32 [%rd6],%f1;
DONE: ret;
}
